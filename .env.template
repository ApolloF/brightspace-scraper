# Brightspace RUG Sync Tool Configuration

# Base URL for the Brightspace LMS (default for University of Groningen)
BRIGHTSPACE_BASE_URL=https://brightspace.rug.nl

# Your private Brightspace calendar feed URL (iCal link)
# You can get this by going to Calendar -> Settings -> Subscribe -> Copy the link address.
CALENDAR_ICAL_URL=https://brightspace.rug.nl/d2l/le/calendar/feed/user/feed.ics?token=example_token

# Path where course materials should be downloaded
DOWNLOADS_DIR=downloads

# Name of the Google Calendar where you want to sync your schedule
GOOGLE_CALENDAR_NAME=Brightspace Sync
